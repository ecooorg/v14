GEMINI_API_KEY=
APP_PASSWORD=change-this-password
SESSION_SECRET=change-this-to-a-long-random-string
ENABLE_APP_AUTH=true
VITE_GOOGLE_CLIENT_ID=
MODEL_CASCADE_LIGHT=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest
MODEL_CASCADE_STRONG=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-latest,gemini-flash-lite-latest,gemini-3.8-flash
RATE_LIMIT_PER_HOUR=60
DAILY_CALL_CAP=200

LLM_CALL_TIMEOUT_MS=25000
LLM_TOTAL_DEADLINE_MS=70000

# Sign-in (required together with ENABLE_APP_AUTH / APP_PASSWORD): any random string, 16+ characters
# SESSION_SECRET=
# Failed sign-ins allowed per window per address (defaults: 10 per 15 minutes)
# LOGIN_MAX_FAILS=10
# LOGIN_WINDOW_MIN=15
# Number of trusted proxy hops in front of the app (Railway: 1)
# TRUST_PROXY_HOPS=1

# Max model responses per request, including the one format retry (default 4)
# MAX_MODEL_CALLS=4

# Attachments: largest file in bytes (default 10 MB) and text passed to the model per file (default 30000 characters)
# MAX_UPLOAD_BYTES=10485760
# MAX_ATTACH_TEXT_CHARS=30000
