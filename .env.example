DATABASE_URL=
PG_POOL_MAX=5
PGSSLMODE=require
GEMINI_API_KEY=
APP_PASSWORD=change-this-password
SESSION_SECRET=change-this-to-a-long-random-string
ENABLE_APP_AUTH=true
# Opt-in Project Mode; requires DATABASE_URL, APP_PASSWORD, SESSION_SECRET and ENABLE_APP_AUTH=true
ENABLE_PROJECT_MODE=false
PROJECT_RATE_LIMIT_PER_MINUTE=60
VITE_GOOGLE_CLIENT_ID=
MODEL_CASCADE_LIGHT=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
MODEL_CASCADE_STRONG=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
RATE_LIMIT_PER_HOUR=60
DAILY_CALL_CAP=200

LLM_CALL_TIMEOUT_MS=25000
LLM_TOTAL_DEADLINE_MS=70000
MAX_MODEL_CALLS=4

# Sign-in (required together with ENABLE_APP_AUTH / APP_PASSWORD): any random string, 16+ characters
# SESSION_SECRET=
# Failed sign-ins allowed per window per address (defaults: 10 per 15 minutes)
# LOGIN_MAX_FAILS=10
# LOGIN_WINDOW_MIN=15
# Number of trusted proxy hops in front of the app (Railway: 1)
# TRUST_PROXY_HOPS=1

# Max model responses per request, including the one format retry (default 4)
# MAX_MODEL_CALLS=4

# P57 latency policy (defaults keep answers unchanged; every value can be set to restore the earlier behaviour)
# Skip the "rewrite from scratch" quality retry when the turn has already taken longer than this many ms (default 12000; 0 = never skip)
# QUALITY_RETRY_MAX_ELAPSED_MS=12000
# How long the optional Groq verifier may take before it is dropped, ms (default 5000; was 12000)
# EPISTEMIC_TIMEOUT_MS=5000
# Older assistant messages (all but the last two messages) are cut to this many characters in the model input (default 2500; 0 = no cutting)
# OLDER_ASSISTANT_MAX_CHARS=2500

# Attachments: largest file in bytes (default 10 MB) and text passed to the model per file (default 30000 characters)
# MAX_UPLOAD_BYTES=10485760
# MAX_ATTACH_TEXT_CHARS=30000

# Attached file text allowed in expert requests (default 20000 characters)
# EXPERT_ATTACH_TOTAL_CHARS=20000
# Request body limit in bytes (default 262144)
# MAX_BODY_BYTES=262144
# Alternative Gemini endpoint (tests use it for a fake server)
# GEMINI_BASE_URL=
# Commit shown by /health when RAILWAY_GIT_COMMIT_SHA is absent
# GIT_COMMIT=
# Tests only: skip the dist/ presence check in production health
# SKIP_DIST_HEALTHCHECK=true
# Development only: disable hot reload
# DISABLE_HMR=true

# GitHub App integration (P16). Keep private key and webhook secret in Railway Variables only.
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_REPOSITORY_OWNER=
# GITHUB_REPOSITORY_NAME=
# Optional GitHub API base URL for tests only; leave unset in production.
# GITHUB_API_BASE_URL=
# Code executor (ADR-10 / P43). Default without the var is manual.
# RM-C3 closed 2026-10-15: owner authorized model_patch. Set explicitly in Railway to enable.
# ADR-06 Amendment 1 (P53): model_patch means "generate a source ZIP" only; it does NOT switch on any GitHub write.
# CODE_EXECUTOR=model_patch
# CODE_EXECUTOR=manual
# The ONLY GitHub write switch (ADR-06 Amendment 1). Off in this release: the GitHub App stays read-only.
# P18: set to true only when the GitHub App has contents:write and pull_requests:write; lets a human upload a diff that BiForge commits to biforge/<task_id> and opens as a PR. Off by default.
# GITHUB_DIFF_UPLOAD=true

# P50: web search for fresh facts. Off by default; set true to enable.
# ENABLE_WEB_SEARCH=false
# auto = explicit asks and clearly time-sensitive questions; explicit = only when the person asks to search
# WEB_SEARCH_MODE=auto
# Provider: serper | gemini. Auto = serper when SERPER_API_KEY is set, else gemini.
# Serper (recommended on free Gemini keys — no Google Search grounding quota needed):
# WEB_SEARCH_PROVIDER=serper
# SERPER_API_KEY=
# Gemini path only (needs a key with Search grounding quota; 2.5 models are closed to new projects):
# WEB_SEARCH_PROVIDER=gemini
# WEB_SEARCH_MODEL=
# WEB_SEARCH_TIMEOUT_MS=28000
# After Serper SERP, open top pages and read body text (Jina Reader, no key). Default true.
# WEB_SEARCH_FETCH_PAGES=true
# WEB_SEARCH_MAX_PAGES=4
# Max Serper queries per turn for rate-like topics (default 5; each costs 1 credit)
# WEB_SEARCH_MAX_QUERIES=5
# Optional model for translating non-English user text into an English search query (default: first of MODEL_CASCADE_LIGHT)
# WEB_SEARCH_TRANSLATE_MODEL=gemini-3.5-flash-lite
